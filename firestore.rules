rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    function manages(uid) { return owner(uid) || admin(); }
    function published(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      let projection = get(/databases/$(database)/documents/publicUsers/$(uid)).data;
      return profile.isPublic == true && projection.isPublic == true && profile.username == projection.username;
    }
    match /publicUsers/{uid} {
      allow get: if owner(uid) || (resource.data.keys().hasOnly(['username','displayName','institution','isPublic'])
        && resource.data.isPublic == true && published(uid));
      allow create, update: if manages(uid)
        && request.resource.data.keys().hasAll(['username','displayName','institution','isPublic'])
        && request.resource.data.keys().hasOnly(['username','displayName','institution','isPublic'])
        && request.resource.data.username == getAfter(/databases/$(database)/documents/users/$(uid)).data.username
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName
        && request.resource.data.institution == getAfter(/databases/$(database)/documents/users/$(uid)).data.institution
        && request.resource.data.isPublic == getAfter(/databases/$(database)/documents/users/$(uid)).data.isPublic;
      match /observations/{id} {
        allow read: if owner(uid) || (resource.data.keys().hasOnly(['eventId','eventName','dateTime','siteName','tag']) && published(uid));
        allow delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasAll(['eventId','eventName','dateTime','siteName','tag'])
          && request.resource.data.keys().hasOnly(['eventId','eventName','dateTime','siteName','tag'])
          && request.resource.data.eventId is string && request.resource.data.eventId.matches('^[A-Za-z0-9_-]{1,128}$')
          && request.resource.data.eventName is string && request.resource.data.eventName.size() > 0 && request.resource.data.eventName.size() <= 200
          && request.resource.data.dateTime is timestamp
          && request.resource.data.siteName is string && request.resource.data.siteName.size() > 0 && request.resource.data.siteName.size() <= 100
          && request.resource.data.tag in ['interested','planned','observed'];
      }
    }
    function profileValid(d) {
      return d.keys().hasAll(['username','displayName','institution','isPublic','email','theme','updatedAt'])
        && d.keys().hasOnly(['username','displayName','institution','isPublic','email','theme','updatedAt','isAdmin'])
        && d.get('isAdmin', false) is bool
        && d.username is string && (d.username == '' || d.username.matches('^[a-z0-9][a-z0-9_-]{1,28}[a-z0-9]$'))
        && d.displayName is string && d.displayName.size() <= 100
        && d.institution is string && d.institution.size() <= 150
        && d.isPublic is bool && d.email is string && d.email.size() <= 320
        && d.theme in ['dark','light','red']
        && d.updatedAt == request.time;
    }
    function siteValid(d) {
      return d.keys().hasAll(['name','latitude','longitude','radiusKm','minObservationAltitude','updatedAt'])
        && d.keys().hasOnly(['name','latitude','longitude','radiusKm','minObservationAltitude','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
        && d.radiusKm is number && d.radiusKm > 0 && d.radiusKm <= 5000
        && d.minObservationAltitude is number && d.minObservationAltitude >= 0 && d.minObservationAltitude <= 90
        && d.updatedAt == request.time;
    }
    function observationValid(d) {
      return d.keys().hasAll(['eventId','siteId','tag','eventName','dateTime','siteName','updatedAt'])
        && d.keys().hasOnly(['eventId','siteId','siteSource','tag','eventName','dateTime','siteName','updatedAt'])
        && d.get('siteSource', 'personal') in ['personal', 'default']
        && d.eventId is string && d.eventId.matches('^[A-Za-z0-9_-]{1,128}$')
        && d.siteId is string && d.siteId.matches('^[A-Za-z0-9_-]{1,128}$')
        && d.tag in ['interested','planned','observed']
        && d.eventName is string && d.eventName.size() > 0 && d.eventName.size() <= 200
        && d.dateTime is timestamp
        && d.siteName is string && d.siteName.size() > 0 && d.siteName.size() <= 100
        && d.updatedAt == request.time;
    }
    function observationSiteMatches(uid, d) {
      return d.get('siteSource', 'personal') == 'default'
        ? get(/databases/$(database)/documents/defaultSites/$(d.siteId)).data.name == d.siteName
        : get(/databases/$(database)/documents/users/$(uid)/sites/$(d.siteId)).data.name == d.siteName;
    }
    match /users/{uid} {
      allow get: if manages(uid);
      allow list: if admin();
      allow create: if owner(uid) && profileValid(request.resource.data)
        && request.resource.data.isAdmin == false
        && request.resource.data.username == '' && request.resource.data.isPublic == false;
      allow update: if manages(uid) && profileValid(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']) || admin())
        && (owner(uid) || request.resource.data.email == resource.data.email)
        && (request.resource.data.username != '' || request.resource.data.isPublic == false)
        && (request.resource.data.username == resource.data.username
          || (request.resource.data.username != ''
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
            && (resource.data.username == ''
              || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username)))));
      match /sites/{siteId} {
        allow read, delete: if manages(uid);
        allow create: if owner(uid) && siteValid(request.resource.data);
        allow update: if manages(uid) && siteValid(request.resource.data);
      }
      match /observations/{obsId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && observationValid(request.resource.data)
          && observationSiteMatches(uid, request.resource.data);
      }
    }
    match /usernames/{username} {
      allow get: if request.auth != null || (resource != null
        && get(/databases/$(database)/documents/users/$(resource.data.uid)).data.isPublic == true
        && get(/databases/$(database)/documents/users/$(resource.data.uid)).data.username == username);
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && manages(request.resource.data.uid)
        && username.matches('^[a-z0-9][a-z0-9_-]{1,28}[a-z0-9]$')
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.username == username;
      allow update: if manages(resource.data.uid)
        && request.resource.data == resource.data;
      allow delete: if manages(resource.data.uid)
        && getAfter(/databases/$(database)/documents/users/$(resource.data.uid)).data.username != username;
    }
    match /defaultSites/{siteId} {
      allow get, list: if true;
    }

    // Old prediction cache and every unlisted collection are inaccessible to clients.
    match /predictionCache/{eventId} { allow read, write: if false; }
  }
}
